---
import { LINKS } from '~consts/links';
import { NAV_GROUPS } from '~consts/navigation';

const legal = [
  { name: 'Privacy policy', href: LINKS.privacyPolicy },
  { name: 'Terms and conditions', href: LINKS.terms },
];

const company = [
  { name: 'Pricing', href: '/pricing/' },
  { name: 'Docs', href: LINKS.docs },
  { name: 'Status', href: LINKS.status },
  { name: 'LinkedIn', href: LINKS.linkedin },
  { name: 'X', href: LINKS.twitter },
  { name: 'Facebook', href: LINKS.facebook },
  { name: 'Medium', href: LINKS.medium },
];

const columns = [
  ...NAV_GROUPS.map(({ label, items }) => ({
    label,
    items: [...new Map(items.map((item) => [item.href, item])).values()],
  })),
  { label: 'Company', items: company },
  { label: 'Legal', items: legal },
];

const year = new Date().getFullYear();
---

<footer class="footer" data-theme="ink">
  <div class="container">
    <div class="top">
      <a class="logo" href="/" aria-label="Inspector home">
        <img
          src="/images/logo-horizontal-white-transparent.png"
          width="130"
          height="38"
          alt="Inspector"
        />
      </a>
      <p class="note">Give your coding agent eyes on production.</p>
    </div>

    <nav class="columns" aria-label="Footer">
      {columns.map(({ label, items }) => (
        <section>
          <h2 class="label">{label}</h2>
          <ul class="items">
            {items.map(({ name, href }) => (
              <li>
                <a href={href}>{name}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>

    <div class="legal">
      <p>© {year} Inspector S.R.L. VAT 09552901218</p>
      <p>
        Progetto agevolato con la misura Resto al SUD RSUD0000000 - CUP
        C61B21012300008
      </p>
    </div>
  </div>
</footer>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .footer {
    padding-block: var(--space-7) var(--space-5);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .top {
    display: grid;
    gap: var(--space-2);
  }

  .logo {
    justify-self: start;
    margin-left: calc(var(--space-2) * -1);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-5);
    margin-top: var(--space-6);
  }

  .label {
    max-width: none;

    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
  }

  .items {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  a {
    color: var(--text-muted);
    text-decoration: none;

    &:hover {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .legal {
    display: grid;
    gap: var(--space-1);

    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);

    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  @include media-min('sm') {
    .columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @include media-min('md') {
    .columns {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
