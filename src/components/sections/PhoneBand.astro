---
import AgentSession from '~components/product/AgentSession.astro';
import Section from '~components/sections/Section.astro';
import Checks from '~components/ui/Checks.astro';
import { WEB_CLIENTS } from '~consts/mcp';
import { PHONE_SESSION } from '~consts/samples';

const webClients = new Intl.ListFormat('en-GB', {
  type: 'disjunction',
}).format(WEB_CLIENTS);
---

<Section theme="ink">
  <div class="band">
    <div class="copy">
      <h2>Investigate, fix and release from your phone</h2>
      <p class="lead">
        Connect Inspector to {webClients} on the web. You sign in and approve
        the connection, with no API key to paste.
      </p>
      <Checks
        class="list"
        items={[
          'Read-only access to errors, transactions and performance data',
          'No access to billing, team members or API keys',
          'Only the apps you have access to',
        ]}
      />
    </div>
    <AgentSession class="agent" {...PHONE_SESSION} raised />
  </div>
</Section>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .band {
    display: grid;
    gap: var(--space-6);
  }

  .band > * {
    min-width: 0;
  }

  .list {
    margin-top: var(--space-5);
  }

  @include media-min('md') {
    .band {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-5);
      align-items: center;
    }

    .copy {
      grid-column: span 6;
    }

    .agent {
      grid-column: 8 / span 5;
    }
  }
</style>
