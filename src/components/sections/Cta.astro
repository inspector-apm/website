---
import PageHero from '~components/sections/PageHero.astro';
import Button from '~components/ui/Button.astro';
import TextLink from '~components/ui/TextLink.astro';
import { LINKS } from '~consts/links';
import { FREE_NOTE } from '~consts/pricing';
---

<PageHero
  heading="h2"
  title="Give your coding agent eyes on production"
  lead="Install the package, connect your agent, and let it find the next problem before your customers do."
  note={FREE_NOTE}
>
  <Button slot="actions" text="Start free" href={LINKS.register} />
  <TextLink slot="actions" text="Read the docs" href={LINKS.docs} />
</PageHero>
