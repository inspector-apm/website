---
import AgentSession from '~components/product/AgentSession.astro';
import Timeline from '~components/product/Timeline.astro';
import { N_PLUS_ONE_TRACE, SLOW_QUERY_SESSION } from '~consts/samples';
---

<div class="stage">
  <Timeline class="trace" {...N_PLUS_ONE_TRACE} animated />
  <AgentSession class="agent" {...SLOW_QUERY_SESSION} />
</div>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .stage {
    display: grid;
    gap: var(--space-4);
  }

  @include media-min('md') {
    .stage {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .trace {
      grid-column: span 7;
    }

    .agent {
      grid-column: span 5;
    }
  }
</style>
