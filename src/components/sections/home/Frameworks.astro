---
import Section from '~components/sections/Section.astro';
import RowList from '~components/ui/RowList.astro';
import { INTEGRATIONS } from '~consts/frameworks';

const rows = INTEGRATIONS.map(({ name, href, command }) => ({
  label: name,
  value: command,
  href,
}));
---

<Section
  title="Built for the PHP frameworks you use"
  lead="Each integration is one Composer package, built for how your framework works."
>
  <RowList rows={rows} mono="value" />
</Section>
