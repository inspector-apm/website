---
import Section from '~components/sections/Section.astro';

interface Props {
  title: string;
  lead: string;
  note?: string;
  heading?: 'h1' | 'h2';
  logo?: { src: string; alt: string };
}

const { title, lead, note, heading: Heading = 'h1', logo } = Astro.props;
---

<Section>
  <div class="intro">
    <div>
      <Heading>{title}</Heading>
      <p class="lead">{lead}</p>
      {Astro.slots.has('actions') && (
        <div class="actions">
          <slot name="actions" />
        </div>
      )}
      {note && <p class="note hint">{note}</p>}
    </div>
    {logo && (
      <img
        class="logo"
        src={logo.src}
        alt={logo.alt}
        width="192"
        height="192"
      />
    )}
    {Astro.slots.has('aside') && (
      <div class="aside">
        <slot name="aside" />
      </div>
    )}
  </div>
  {Astro.slots.has('default') && (
    <div class="stage">
      <slot />
    </div>
  )}
</Section>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .intro {
    display: grid;
    gap: var(--space-5);
  }

  .logo {
    order: -1;

    width: var(--space-8);
    height: var(--space-8);

    object-fit: contain;
    object-position: left;
  }

  .hint {
    margin-top: var(--space-3);
  }

  .stage {
    margin-top: var(--space-7);
  }

  @include media-min('sm') {
    .intro {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-6);
      align-items: center;
    }

    .intro:has(.aside) {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .logo {
      order: 0;
      width: var(--space-9);
      height: var(--space-9);
      object-position: right;
    }
  }

  @include media-min('md') {
    .logo {
      width: calc(var(--space-9) * 2);
      height: calc(var(--space-9) * 2);
    }
  }
</style>
