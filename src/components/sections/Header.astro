---
import Button from '~components/ui/Button.astro';
import Icon from '~components/ui/Icon.astro';
import Logo from '~components/ui/Logo.astro';
import { LINKS } from '~consts/links';
import { NAV_GROUPS } from '~consts/navigation';
---

<header class="header" data-theme="ink">
  <div class="container bar">
    <Logo />

    <nav class="desktopNav" aria-label="Main">
      <ul class="links">
        {NAV_GROUPS.map(({ label, items }) => (
          <li class="group">
            <details data-menu>
              <summary class="link">
                {label}
                <span class="chevron">
                  <Icon name="chevron-down" />
                </span>
              </summary>
              <ul class="menu">
                {items.map(({ name, description, href }) => (
                  <li>
                    <a class="entry" href={href}>
                      <strong>{name}</strong>
                      <span class="caption">{description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))}
        <li>
          <a class="link" href="/pricing/">
            Pricing
          </a>
        </li>
        <li>
          <a class="link" href={LINKS.docs}>
            Docs
          </a>
        </li>
      </ul>
    </nav>

    <div class="tools">
      <a class="link signIn" href={LINKS.signIn}>
        Sign in
      </a>
      <Button text="Start free" href={LINKS.register} />
      <button
        class="toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobileNav"
        data-nav-toggle
      >
        <span class="toggleOpen">
          <Icon name="list" />
        </span>
        <span class="toggleClose">
          <Icon name="x-lg" />
        </span>
      </button>
    </div>
  </div>

  <nav id="mobileNav" class="mobileNav" aria-label="Main" hidden>
    <div class="container">
      {NAV_GROUPS.map(({ label, items }) => (
        <section class="mobileGroup">
          <h2 class="plainHeading caption mobileLabel">{label}</h2>
          <ul>
            {items.map(({ name, href }) => (
              <li>
                <a class="mobileLink" href={href}>
                  {name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <section class="mobileGroup">
        <ul>
          <li>
            <a class="mobileLink" href="/pricing/">
              Pricing
            </a>
          </li>
          <li>
            <a class="mobileLink" href={LINKS.docs}>
              Docs
            </a>
          </li>
          <li>
            <a class="mobileLink" href={LINKS.signIn}>
              Sign in
            </a>
          </li>
        </ul>
      </section>
    </div>
  </nav>
</header>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .header {
    position: relative;
    z-index: var(--z-index-menu);
    font-size: var(--font-size-small);
    line-height: 1.5;
  }

  .bar {
    display: flex;
    gap: var(--space-5);
    align-items: center;
    min-height: var(--space-8);
  }

  .desktopNav {
    display: none;
  }

  .links {
    display: flex;
    gap: var(--space-1);
    align-items: center;
  }

  .group {
    position: relative;
  }

  .link {
    cursor: pointer;

    display: inline-flex;
    gap: var(--space-1);
    align-items: center;

    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);

    color: var(--text);
    text-decoration: none;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      background-color: var(--surface);
    }
  }

  .link.signIn {
    display: none;
  }

  details[open] > .link {
    background-color: var(--surface);
  }

  .chevron {
    font-size: var(--font-size-caption);
    color: var(--text-muted);
  }

  .menu {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;

    width: 20rem;
    padding: var(--space-2);
    border-radius: var(--radius-md);

    background-color: var(--surface);
    box-shadow: var(--shadow-menu);
  }

  .entry {
    display: grid;

    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);

    color: var(--text);
    text-decoration: none;

    &:hover {
      background-color: var(--surface-sunken);
    }

    strong {
      font-weight: 500;
    }
  }

  .tools {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-left: auto;
  }

  .toggle {
    cursor: pointer;

    display: inline-flex;

    padding: var(--space-2);
    border: 0;
    border-radius: var(--radius-md);

    font-size: var(--font-size-title-lg);
    color: var(--text);

    background: none;
  }

  .toggleClose {
    display: none;
  }

  .toggle[aria-expanded='true'] {
    .toggleOpen {
      display: none;
    }

    .toggleClose {
      display: inline-flex;
    }
  }

  .mobileNav {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;

    padding-block: var(--space-2) var(--space-5);
    border-top: 1px solid var(--line);

    background-color: var(--ground);
    box-shadow: var(--shadow-menu);
  }

  .mobileGroup {
    padding-block: var(--space-3);

    & + & {
      border-top: 1px solid var(--line);
    }
  }

  .mobileLabel {
    padding-block: var(--space-1);
  }

  .mobileLink {
    display: block;

    padding-block: var(--space-2);

    font-size: var(--font-size-body);
    color: var(--text);
    text-decoration: none;
  }

  @include media-min('md') {
    .desktopNav {
      display: block;
    }

    .link.signIn {
      display: inline-flex;
    }

    .toggle,
    .mobileNav {
      display: none;
    }
  }
</style>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const mobileNav = document.querySelector<HTMLElement>('#mobileNav');

  function setMobileNav(open: boolean) {
    if (!toggle || !mobileNav) return;

    mobileNav.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  for (const menu of menus) {
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;

      for (const other of menus) {
        if (other !== menu) other.open = false;
      }
    });

    menu.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;

      if (next instanceof Node && !menu.contains(next)) menu.open = false;
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element;

    for (const menu of menus) {
      if (!menu.contains(target)) menu.open = false;
    }

    if (!target.closest('#mobileNav, [data-nav-toggle]')) setMobileNav(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    for (const menu of menus) {
      if (!menu.open) continue;

      menu.open = false;
      menu.querySelector('summary')?.focus();
    }

    if (mobileNav && !mobileNav.hidden) {
      setMobileNav(false);
      toggle?.focus();
    }
  });

  toggle?.addEventListener('click', () => {
    setMobileNav(Boolean(mobileNav?.hidden));
  });
</script>
