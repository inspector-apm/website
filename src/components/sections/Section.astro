---
interface Props {
  title?: string;
  lead?: string;
  theme?: 'ink';
  class?: string;
}

const { title, lead, theme, class: className } = Astro.props;
---

<section class:list={['section', className]} data-theme={theme}>
  <div class="container">
    {title && <h2>{title}</h2>}
    {lead && <p class="lead">{lead}</p>}
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .section {
    padding-block: var(--space-8);

    @include media-min('md') {
      padding-block: var(--space-9);
    }
  }

  .section:not([data-theme]) + .section:not([data-theme]) {
    padding-top: 0;
  }

  .body:not(:first-child) {
    margin-top: var(--space-6);
  }
</style>
