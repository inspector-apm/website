---
interface Props {
  current: number;
  last: number;
  base: string;
  class?: string;
}

const { current, last, base, class: className } = Astro.props;

const href = (page: number) => (page === 1 ? base : `${base}${page}/`);
const pages = [...new Set([1, current - 1, current, current + 1, last])]
  .filter((page) => page >= 1 && page <= last)
  .sort((a, b) => a - b);
---

<nav class:list={['pagination', className]} aria-label="Pagination">
  {current > 1 && (
    <a class="step" href={href(current - 1)}>
      Previous
    </a>
  )}
  {pages.map((page, index) => (
    <>
      {page - (pages[index - 1] ?? page) > 1 && (
        <span class="gap" aria-hidden="true">
          ...
        </span>
      )}
      <a
        class="step"
        href={href(page)}
        aria-label={`Page ${page}`}
        aria-current={page === current ? 'page' : undefined}
      >
        {page}
      </a>
    </>
  ))}
  {current < last && (
    <a class="step" href={href(current + 1)}>
      Next
    </a>
  )}
</nav>

<style lang="scss">
  .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;

    font-size: var(--font-size-small);
    line-height: 1.5;
  }

  .step {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;

    &:hover {
      background-color: var(--surface);
    }

    &[aria-current] {
      color: var(--ground);
      background-color: var(--text);
    }
  }

  .gap {
    padding-inline: var(--space-1);
    color: var(--text-muted);
  }
</style>
