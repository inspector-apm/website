---
interface Props {
  name: string;
}

const icons = import.meta.glob<string>('../../assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const { name } = Astro.props;
---

<span
  class="icon"
  aria-hidden="true"
  set:html={icons[`../../assets/icons/${name}.svg`]}
/>

<style>
  .icon {
    display: inline-flex;
    flex: none;
  }

  .icon :global(svg) {
    width: 1em;
    height: 1em;
    fill: currentcolor;
  }
</style>
