---
export type IconName =
  | 'activity'
  | 'check-lg'
  | 'chevron-down'
  | 'chevron-right'
  | 'clipboard'
  | 'database'
  | 'list'
  | 'plug'
  | 'shield-check'
  | 'x-lg';

interface Props {
  name: IconName;
}

const icons = import.meta.glob<string>('../../assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const { name } = Astro.props;
---

<span
  class="icon"
  aria-hidden="true"
  set:html={icons[`../../assets/icons/${name}.svg`]}
/>

<style lang="scss">
  .icon {
    display: inline-flex;
    flex: none;
  }

  .icon :global(svg) {
    width: 1em;
    height: 1em;
    fill: currentcolor;
  }
</style>
