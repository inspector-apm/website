---
interface Props {
  text: string;
  author?: string;
  role?: string;
  size?: 'large';
  card?: boolean;
  class?: string;
}

const { text, author, role, size, card, class: className } = Astro.props;
---

<figure class:list={[size, { card }, className]}>
  <blockquote class="text">{text}</blockquote>
  <figcaption class="credit">
    {author && <strong>{author}</strong>}
    {role && <span>{role}</span>}
  </figcaption>
  {Astro.slots.has('default') && (
    <div class="more">
      <slot />
    </div>
  )}
</figure>

<style lang="scss">
  .large .text {
    max-width: var(--measure);

    font-size: var(--font-size-title-lg);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .credit {
    display: grid;
    margin-top: var(--space-3);
    font-size: var(--font-size-small);
    line-height: 1.5;
  }

  .card {
    padding: var(--space-5);
  }

  .card .text::before {
    content: '“';

    display: block;

    height: var(--space-5);

    font-size: var(--font-size-display);
    font-weight: 600;
    line-height: 1;
    color: var(--segment);
  }

  .card .credit {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .credit strong {
    font-weight: 500;
  }

  .credit span {
    color: var(--text-muted);
  }

  .more {
    margin-top: var(--space-4);
  }
</style>
