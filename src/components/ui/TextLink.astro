---
import Icon from '~components/ui/Icon.astro';

interface Props {
  text: string;
  href: string;
}

const { text, href } = Astro.props;
---

<a class="link" href={href}>
  {text}
  <Icon name="chevron-right" />
</a>

<style>
  .link {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;

    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    text-underline-offset: 3px;
  }

  .link :global(svg) {
    font-size: 0.75rem;
  }
</style>
