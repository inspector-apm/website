---
import Icon from '~components/ui/Icon.astro';

interface Props {
  items: string[];
  columns?: boolean;
  class?: string;
}

const { items, columns, class: className } = Astro.props;
---

<ul class:list={['checks', { columns }, className]}>
  {items.map((item) => (
    <li class="item">
      <span class="mark">
        <Icon name="check-lg" />
      </span>
      <span>{item}</span>
    </li>
  ))}
</ul>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .checks {
    display: grid;
    gap: var(--space-2);
  }

  .columns {
    @include media-min('xs') {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .item {
    display: grid;
    grid-template-columns: var(--space-4) minmax(0, 1fr);
    gap: var(--space-3);
  }

  .mark {
    padding-top: var(--space-1);
    color: var(--accent-text);
  }
</style>
