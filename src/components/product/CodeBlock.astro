---
import type { CodeLanguage } from 'astro';
import { Code } from 'astro:components';

import Icon from '~components/ui/Icon.astro';

interface Props {
  code: string;
  caption: string;
  lang?: CodeLanguage;
}

const { code, caption, lang = 'plaintext' } = Astro.props;
---

<figure class="block">
  <figcaption class="bar">
    <span>{caption}</span>
    <button class="copy" type="button" aria-label={`Copy ${caption}`} data-copy>
      <span class="idle">
        <Icon name="clipboard" />
      </span>
      <span class="done">
        <Icon name="check-lg" />
      </span>
    </button>
  </figcaption>
  <Code code={code} lang={lang} theme="css-variables" />
</figure>

<style>
  .block {
    --astro-code-foreground: var(--text);
    --astro-code-background: transparent;
    --astro-code-token-keyword: var(--code-keyword);
    --astro-code-token-string: var(--code-string);
    --astro-code-token-string-expression: var(--code-string);
    --astro-code-token-comment: var(--code-comment);
    --astro-code-token-constant: var(--text);
    --astro-code-token-function: var(--text);
    --astro-code-token-parameter: var(--text);
    --astro-code-token-punctuation: var(--text);
    --astro-code-token-link: var(--text);

    overflow: hidden;

    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);

    color: var(--text);

    background-color: var(--surface-sunken);
  }

  .bar {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;

    padding: 0.375rem var(--space-3);
    border-bottom: 1px solid var(--line);

    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .copy {
    cursor: pointer;

    display: inline-flex;

    padding: var(--space-1);
    border: 0;
    border-radius: var(--radius-sm);

    color: var(--text-muted);

    background: none;
  }

  .done {
    display: none;
    color: var(--ok);
  }

  .copy[data-copied] .idle {
    display: none;
  }

  .copy[data-copied] .done {
    display: inline-flex;
  }

  .block :global(pre) {
    padding: var(--space-3);
    font-size: 0.875rem;
    line-height: 1.6;
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-copy]',
  )) {
    button.addEventListener('click', async () => {
      const code = button.closest('figure')?.querySelector('code');
      if (!code) return;

      await navigator.clipboard.writeText(code.innerText);
      button.toggleAttribute('data-copied', true);
      setTimeout(() => button.toggleAttribute('data-copied', false), 1500);
    });
  }
</script>
