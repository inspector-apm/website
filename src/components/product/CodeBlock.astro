---
import type { CodeLanguage } from 'astro';
import { Code } from 'astro:components';

import CardBar from '~components/product/CardBar.astro';
import Icon from '~components/ui/Icon.astro';

interface Props {
  code: string;
  caption: string;
  lang?: CodeLanguage;
}

const { code, caption, lang = 'plaintext' } = Astro.props;
---

<figure class="block">
  <figcaption>
    <CardBar title={caption}>
      <button
        class="copy"
        type="button"
        aria-label={`Copy ${caption}`}
        data-copy
      >
        <span class="idle">
          <Icon name="clipboard" />
        </span>
        <span class="done">
          <Icon name="check-lg" />
        </span>
      </button>
    </CardBar>
  </figcaption>
  <Code code={code} lang={lang} theme="css-variables" />
  <span class="visuallyHidden" role="status"></span>
</figure>

<style lang="scss">
  .block {
    overflow: hidden;

    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);

    color: var(--text);

    background-color: var(--surface-sunken);
  }

  .copy {
    cursor: pointer;

    display: inline-flex;

    padding: var(--space-1);
    border: 0;
    border-radius: var(--radius-sm);

    color: var(--text-muted);

    background: none;
  }

  .done {
    display: none;
    color: var(--ok);
  }

  .copy[data-copied] .idle {
    display: none;
  }

  .copy[data-copied] .done {
    display: inline-flex;
  }

  .block :global(pre) {
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-code);
    line-height: 1.6;
  }

  .block :global(pre):focus-visible {
    outline-offset: -2px;
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-copy]',
  )) {
    button.addEventListener('click', async () => {
      const figure = button.closest('figure');
      const code = figure?.querySelector('code');
      const status = figure?.querySelector('[role="status"]');
      if (!code || !status) return;

      await navigator.clipboard.writeText(code.innerText);
      button.toggleAttribute('data-copied', true);
      status.textContent = 'Copied';
      setTimeout(() => {
        button.toggleAttribute('data-copied', false);
        status.textContent = '';
      }, 1500);
    });
  }
</script>
