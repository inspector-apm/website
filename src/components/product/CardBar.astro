---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="bar caption">
  <span>{title}</span>
  <slot />
</div>

<style lang="scss">
  .bar {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;

    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line);

    font-family: var(--font-sans);
  }
</style>
