---
import Diff from '~components/product/Diff.astro';
import { FIX_PROPOSAL } from '~consts/samples';

const { title, file, explanation, removed, added } = FIX_PROPOSAL;
---

<article class="card">
  <p class="caption">Bug fix proposal</p>
  <h3>{title}</h3>
  <p class="text" set:html={explanation} />
  <Diff file={file} removed={removed} added={added} />
</article>

<style lang="scss">
  .card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  .text {
    font-size: var(--font-size-small);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .text :global(code) {
    font-size: var(--font-size-code-sm);
    color: var(--text);
  }
</style>
