---
import Button from '~components/ui/Button.astro';
import IconCard from '~components/ui/IconCard.astro';
import { INTEGRATIONS } from '~consts/frameworks';
---

<aside class="sidebar" aria-label="Inspector">
  <IconCard
    theme="ink"
    icon="plug"
    title="Connect your coding agent to production"
    text="The Inspector MCP server lets your agent read your application's errors and performance data, find the cause and fix your code."
  >
    <Button text="See the MCP server" href="/mcp-server/" />
  </IconCard>

  <IconCard
    icon="activity"
    title="Monitor your application"
    text="Each integration is one Composer package, built for how your framework works."
  >
    <ul class="frameworks">
      {INTEGRATIONS.map(({ name, href }) => (
        <li>
          <a href={href}>{name}</a>
        </li>
      ))}
    </ul>
    <Button
      class="more"
      text="See the monitoring tool"
      href="/product-features/"
      variant="quiet"
    />
  </IconCard>
</aside>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .sidebar {
    display: grid;
    gap: var(--space-4);

    @include media-min('sm') {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include media-min('md') {
      grid-template-columns: minmax(0, 1fr);
      align-self: start;

      // Sticks only when both cards fit, or the second one couldn't be reached.
      @media (height >= 50rem) {
        position: sticky;
        top: var(--space-5);
      }
    }
  }

  .frameworks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-1) var(--space-3);

    font-size: var(--font-size-small);
    line-height: 1.5;

    a {
      text-underline-offset: 3px;
    }
  }

  .more {
    margin-top: var(--space-4);
  }
</style>
