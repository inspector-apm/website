---
import Footer from '~components/sections/Footer.astro';
import Header from '~components/sections/Header.astro';
import '~styles/styles.scss';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: { published: Date; modified: Date };
  schema?: object;
  noindex?: boolean;
}

const { title, description, image, article, schema, noindex } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(image ?? '/images/logo-square-flat.png', Astro.site)
  .href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex' : 'max-image-preview:large'}
    />

    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link
      rel="preload"
      href="/fonts/Sora-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:site_name" content="Inspector" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.published.toISOString()}
        />
        <meta
          property="article:modified_time"
          content={article.modified.toISOString()}
        />
      </>
    )}
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
      />
    )}

    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="76cf805e-793d-4709-bbaf-e7f3d853e076"
      ></script>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
