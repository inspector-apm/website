---
import MainLayout from '~components/layouts/MainLayout.astro';
import AgentSession from '~components/product/AgentSession.astro';
import Timeline from '~components/product/Timeline.astro';
import Cta from '~components/sections/Cta.astro';
import FeatureRow from '~components/sections/FeatureRow.astro';
import PageHero from '~components/sections/PageHero.astro';
import Section from '~components/sections/Section.astro';
import Steps from '~components/sections/Steps.astro';
import Button from '~components/ui/Button.astro';
import Checks from '~components/ui/Checks.astro';
import TextLink from '~components/ui/TextLink.astro';
import { FRAMEWORKS } from '~consts/frameworks';
import type { Framework } from '~consts/frameworks';
import { LINKS } from '~consts/links';
import { N_PLUS_ONE_TRACE, SLOW_QUERY_SESSION } from '~consts/samples';

interface Props {
  framework: Framework;
}

export function getStaticPaths() {
  return FRAMEWORKS.map((framework) => ({
    params: { framework: framework.slug },
    props: { framework },
  }));
}

const { framework } = Astro.props;
const { slug, name, lead, monitors, note, steps, guideUrl, guideLabel } =
  framework;
---

<MainLayout
  title={`${name} monitoring | Inspector`}
  description={`Monitor your ${name} application in production with Inspector, and give your coding agent the data it needs to fix errors and slow queries.`}
>
  <PageHero
    title={`Monitor your ${name} application in production`}
    lead={lead}
    note={note}
    logo={{ src: `/images/frameworks/${slug}.svg`, alt: `${name} logo` }}
  >
    <Button slot="actions" text="Start free" href={LINKS.register} />
    <TextLink slot="actions" text={guideLabel} href={guideUrl} />
  </PageHero>

  <Section>
    <FeatureRow
      title="What Inspector records"
      text={`Every request in your ${name} application becomes a timeline, so you can see what ran and how long it took.`}
    >
      <Timeline {...N_PLUS_ONE_TRACE} />
      <Checks slot="extra" items={monitors} />
    </FeatureRow>

    <FeatureRow
      title="Then let your coding agent fix it"
      text="Connect your coding agent to the MCP server, and it can read the same data, find the cause and change your code."
    >
      <AgentSession {...SLOW_QUERY_SESSION} />
      <TextLink slot="extra" text="See the MCP server" href="/mcp-server/" />
    </FeatureRow>
  </Section>

  <Section title={`Install Inspector in ${name}`}>
    <Steps steps={steps} />
  </Section>

  <Cta />
</MainLayout>
