---
import MainLayout from '~components/layouts/MainLayout.astro';
import Cta from '~components/sections/Cta.astro';
import PageHero from '~components/sections/PageHero.astro';
import Section from '~components/sections/Section.astro';
import LogoStrip from '~components/ui/LogoStrip.astro';
import Quote from '~components/ui/Quote.astro';
import { LINKS } from '~consts/links';
import { CUSTOMERS, FEATURED_QUOTE, QUOTES } from '~consts/testimonials';
---

<MainLayout
  title="Testimonials | Inspector"
  description="What development teams say about Inspector, and the companies that use it in production."
>
  <PageHero
    title="What teams say about Inspector"
    lead="PHP teams use Inspector to find and fix problems before their customers report them."
  >
    <Quote card size="large" {...FEATURED_QUOTE} />
    <iframe
      slot="aside"
      class="card video"
      src={LINKS.customerReview}
      title={`Customer review by ${FEATURED_QUOTE.author}`}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="autoplay; encrypted-media; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </PageHero>

  <Section
    title="In their own words"
    lead="From live chat, email, surveys and Twitter, as our users wrote them."
  >
    <div class="comments">
      {QUOTES.map((quote) => (
        <Quote class="comment" card {...quote} />
      ))}
    </div>
  </Section>

  <Section title="Used in production">
    <LogoStrip logos={CUSTOMERS} />
  </Section>

  <Cta />
</MainLayout>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .video {
    display: block;
    aspect-ratio: 16 / 9;
    width: 100%;
    border: 0;
  }

  .comments {
    column-gap: var(--space-4);

    @include media-min('sm') {
      column-count: 2;
    }

    @include media-min('md') {
      column-count: 3;
    }
  }

  .comment {
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }
</style>
