---
import MainLayout from '~components/layouts/MainLayout.astro';
import AgentSession from '~components/product/AgentSession.astro';
import CodeBlock from '~components/product/CodeBlock.astro';
import Cta from '~components/sections/Cta.astro';
import PageHero from '~components/sections/PageHero.astro';
import Section from '~components/sections/Section.astro';
import Steps from '~components/sections/Steps.astro';
import Button from '~components/ui/Button.astro';
import Checks from '~components/ui/Checks.astro';
import RowList from '~components/ui/RowList.astro';
import TextLink from '~components/ui/TextLink.astro';
import { LINKS } from '~consts/links';
import {
  CLIENT_CONFIGS,
  MCP_LIMITS,
  MCP_READS,
  MCP_TOOLS,
  MCP_URL,
} from '~consts/mcp';
import { PHONE_SESSION } from '~consts/samples';

const webSteps = [
  {
    title: 'Add a custom connector',
    text: `In Claude, open Settings, then Connectors, and add a custom connector named Inspector with the URL ${MCP_URL}.`,
  },
  {
    title: 'Approve the connection',
    text: 'Sign in to Inspector, check what the connector can access and approve the request.',
  },
  {
    title: 'Ask about production',
    text: 'Back in Claude, try: Are there errors in the app production environment?',
  },
];
---

<MainLayout
  title="MCP server for coding agents | Inspector"
  description="Connect Claude Code, Codex, OpenCode, Claude, ChatGPT and other MCP clients to the production data of your PHP application."
>
  <PageHero
    title="Connect your coding agent to production"
    lead="The Inspector MCP server lets any MCP client read your application's errors and performance data, so your agent can find the cause and fix your code."
    note="Works in the terminal with an API key and on the web with OAuth."
  >
    <Button slot="actions" text="Start free" href={LINKS.register} />
    <TextLink slot="actions" text="Read the MCP docs" href={LINKS.mcpDocs} />
  </PageHero>

  <Section
    title="Connect in the terminal"
    lead="Create an API key in your Inspector dashboard, then add the server to your agent. Any other MCP client needs the same two things: the server URL and your API key."
  >
    <div class="configs">
      {CLIENT_CONFIGS.map(({ caption, code, lang }) => (
        <CodeBlock caption={caption} code={code} lang={lang} />
      ))}
    </div>
  </Section>

  <Section
    title="Connect on the web"
    lead="Web agents use OAuth, so there is no key to paste. This example uses Claude. ChatGPT and other web agents follow the same pattern under different menu names."
  >
    <Steps steps={webSteps} />
  </Section>

  <Section
    title="What your agent can do"
    lead={`The server exposes ${MCP_TOOLS.length} tools. Your agent calls them when it needs production data.`}
  >
    <RowList rows={MCP_TOOLS} mono="label" />
  </Section>

  <Section
    theme="ink"
    title="You stay in control of production"
    lead="The authorization screen shows what an agent can access before you approve it."
  >
    <div class="split access">
      <div class="stack">
        <div>
          <h3>What it can read</h3>
          <Checks class="list" items={MCP_READS} />
        </div>
        <div>
          <h3>What it can't do</h3>
          <Checks class="list" items={MCP_LIMITS} />
        </div>
      </div>
      <AgentSession {...PHONE_SESSION} raised />
    </div>
  </Section>

  <Cta />
</MainLayout>

<style lang="scss">
  @use '~styles/mixins/media' as *;

  .configs {
    display: grid;
    gap: var(--space-4);
  }

  .configs > :global(:first-child) {
    grid-column: 1 / -1;
  }

  @include media-min('md') {
    .configs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .access {
    align-items: start;
  }

  .stack {
    display: grid;
    gap: var(--space-6);
  }

  .list {
    margin-top: var(--space-3);
  }
</style>
